from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error, root_mean_squared_error, r2_score

#StandardScaler
ss = StandardScaler()

X_train_scaled = ss.fit_transform(X_train)
X_test_scaled = ss.transform(X_test)

model_base = LinearRegression()
model_base.fit(X_train_scaled, y_train)

y_pred_base_scaled = model_base.predict(X_test_scaled)

# Accurcy test
MAE_base = mean_absolute_error(y_test,y_pred_base_scaled)
MSE_base = mean_squared_error(y_test,y_pred_base_scaled)
RMSE_base = root_mean_squared_error(y_test,y_pred_base_scaled)
R2_base = r2_score(y_test, y_pred_base_scaled)
print(f"MAE of Linear Regression Model-> {MAE_base}\nMsE of Linear Regression Model-> {MSE_base}\nRMSE of Linear Regression Model-> {RMSE_base}\nR2 of Linear Regression Model-->  {R2_base}")



