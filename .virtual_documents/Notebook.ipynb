    ],
    'RMSE': [
        RMSE_base,
        RMSE_rf,
        root_mean_squared_error(y_test, y_pred_xgb)
    ],
    'R²': [
        R2_base,
        R2_rf,
        r2_score(y_test, y_pred_xgb)
    ]
})

